# ---- Studiq Client Environment ----
# Copy this file to .env and fill in real values.
# NOTE: VITE_ vars are baked into the build — set them on Render
# BEFORE building, then redeploy.

# Backend API base URL (no trailing /api — it's added in code)
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (for "Continue with Google" on the register page)
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
